---
// DesktopPage: the /desktop/ page, rendered once per locale.
// Markup migrated verbatim from the hand-written desktop.html of the static
// site; every visible string comes from src/i18n/{locale}/desktop.json.
import Base from '../../layouts/Base.astro';
import { content } from '../../i18n/content';
import { localePath, localizeLinks, type PageSlug } from '../../i18n/config';
import { pageJsonLd } from '../../lib/jsonld';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = content<any>(locale, 'desktop');
const h = (s: string) => localizeLinks(s, locale);
const p = (slug: PageSlug, hash = '') => localePath(locale, slug) + hash;
---

<Base locale={locale} slug="desktop" title={t.meta.title} description={t.meta.description} jsonLd={pageJsonLd('desktop', locale)} github="https://github.com/unfoldingWord/translationCore4">
<section style="background:linear-gradient(135deg,#01263a 0%,#014263 55%,#0a6f9c 100%);color:#fff"><div class="wrap" style="padding-top:36px;padding-bottom:88px;gap:20px"><p style="font-size:14px;color:#CDEBF1" set:html={h(t['hero']['p'])}></p><h1 style="font-size:56px;color:#fff;max-width:860px;margin-top:14px" set:html={h(t['hero']['h1'])}></h1><p style="font-size:21px;color:#EEF1F6;max-width:640px" set:html={h(t['hero']['p2'])}></p><div style="display:flex;flex-wrap:wrap;gap:14px;align-items:center"><a class="btn" href="#downloads" style="background:#fff;color:#231F20" set:html={h(t['hero']['a'])}></a><a class="btn" href="https://github.com/unfoldingWord/translationCore4" style="background:transparent;color:#fff;border:2px solid rgba(255,255,255,0.6);padding:11px 24px" set:html={h(t['hero']['a2'])}></a><span style="font-size:15px;font-weight:700;color:#fff;background:rgba(255,255,255,0.16);border-radius:999px;padding:8px 16px" set:html={h(t['hero']['span'])}></span></div></div></section>
<section><div class="wrap" style="padding-top:20px"><div style="display:flex;justify-content:center"><div style="border-radius:16px;overflow:hidden;box-shadow:0 24px 50px rgba(1,66,99,0.2);border:1px solid #DCE2EA;width:1100px;max-width:100%"><img loading="lazy" src="/assets/img/tc-desktop-main.png" alt={t['screenshot']['alt']} style="width:100%;display:block"></div></div><p style="font-size:15px;color:#3A3638;text-align:center;margin-top:-14px" set:html={h(t['screenshot']['p'])}></p></div></section>
<section id="modes" style="background:#F2F8FB"><div class="wrap" style="padding-top:72px;padding-bottom:72px;gap:30px"><div style="max-width:700px;display:flex;flex-direction:column;gap:10px"><h2 style="font-size:38px;color:#014263" set:html={h(t['modes']['h2'])}></h2><p style="font-size:18px" set:html={h(t['modes']['p'])}></p></div><div class="tabs" role="tablist" aria-label={t['modes']['label']}><button class="tab" role="tab" id="tab-understand" aria-controls="panel-understand" aria-selected="true" tabindex="0" type="button" set:html={h(t['modes']['button'])}></button><button class="tab" role="tab" id="tab-translate" aria-controls="panel-translate" aria-selected="false" tabindex="-1" type="button" set:html={h(t['modes']['button2'])}></button><button class="tab" role="tab" id="tab-check" aria-controls="panel-check" aria-selected="false" tabindex="-1" type="button" set:html={h(t['modes']['button3'])}></button></div><figure class="tabpanel" role="tabpanel" id="panel-understand" aria-labelledby="tab-understand" style="margin:0;max-width:1000px;width:100%;margin-left:auto;margin-right:auto"><div style="border-radius:14px;overflow:hidden;border:1px solid #D9E6EC;box-shadow:0 18px 40px rgba(1,66,99,0.16)"><img loading="lazy" src="/assets/img/tc-desktop-understand.jpg" alt={t['modes']['alt']} style="width:100%;display:block;aspect-ratio:16/10;object-fit:cover;object-position:top left"></div><figcaption style="text-align:center;margin-top:16px;font-size:19px" set:html={h(t['modes']['figcaption'])}></figcaption></figure><figure class="tabpanel" role="tabpanel" id="panel-translate" aria-labelledby="tab-translate" hidden style="margin:0;max-width:1000px;width:100%;margin-left:auto;margin-right:auto"><div style="border-radius:14px;overflow:hidden;border:1px solid #D9E6EC;box-shadow:0 18px 40px rgba(1,66,99,0.16)"><img loading="lazy" src="/assets/img/tc-desktop-translate.jpg" alt={t['modes']['alt2']} style="width:100%;display:block;aspect-ratio:16/10;object-fit:cover;object-position:top left"></div><figcaption style="text-align:center;margin-top:16px;font-size:19px" set:html={h(t['modes']['figcaption2'])}></figcaption></figure><figure class="tabpanel" role="tabpanel" id="panel-check" aria-labelledby="tab-check" hidden style="margin:0;max-width:1000px;width:100%;margin-left:auto;margin-right:auto"><div style="border-radius:14px;overflow:hidden;border:1px solid #D9E6EC;box-shadow:0 18px 40px rgba(1,66,99,0.16)"><img loading="lazy" src="/assets/img/tc-desktop-check.jpg" alt={t['modes']['alt3']} style="width:100%;display:block;aspect-ratio:16/10;object-fit:cover;object-position:top left"></div><figcaption style="text-align:center;margin-top:16px;font-size:19px" set:html={h(t['modes']['figcaption3'])}></figcaption></figure></div></section>
<section id="checking" style="background:#fff"><div class="wrap" style="padding-top:20px;padding-bottom:20px;gap:30px"><div style="max-width:700px;display:flex;flex-direction:column;gap:10px"><h2 style="font-size:38px;color:#014263" set:html={h(t['checking']['h2'])}></h2></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:20px"><div class="card"><h3 style="font-size:22px;color:#014263" set:html={h(t['checking']['h3'])}></h3><p style="font-size:16px" set:html={h(t['checking']['p'])}></p></div><div class="card"><h3 style="font-size:22px;color:#014263" set:html={h(t['checking']['h32'])}></h3><p style="font-size:16px" set:html={h(t['checking']['p2'])}></p></div><div class="card"><h3 style="font-size:22px;color:#014263" set:html={h(t['checking']['h33'])}></h3><p style="font-size:16px" set:html={h(t['checking']['p3'])}></p></div><div class="card"><h3 style="font-size:22px;color:#014263" set:html={h(t['checking']['h34'])}></h3><p style="font-size:16px" set:html={h(t['checking']['p4'])}></p></div><div class="card"><h3 style="font-size:22px;color:#014263" set:html={h(t['checking']['h35'])}></h3><p style="font-size:16px" set:html={h(t['checking']['p5'])}></p></div><div class="card"><h3 style="font-size:22px;color:#014263" set:html={h(t['checking']['h36'])}></h3><p style="font-size:16px" set:html={h(t['checking']['p6'])}></p></div></div></div></section>
<section id="how" style="background:#F1F4F8"><div class="wrap" style="padding-top:64px;padding-bottom:64px;gap:30px"><div style="max-width:700px;display:flex;flex-direction:column;gap:10px"><h2 style="font-size:38px;color:#014263" set:html={h(t['how']['h2'])}></h2></div><ol style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:14px"><li style="display:flex;gap:18px;align-items:flex-start;background:#fff;border:1px solid #DCE2EA;border-radius:14px;padding:20px 24px"><span style="flex:none;width:40px;height:40px;border-radius:50%;background:#014263;color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:18px">1</span><span style="font-size:17px" set:html={h(t['how']['span'])}></span></li><li style="display:flex;gap:18px;align-items:flex-start;background:#fff;border:1px solid #DCE2EA;border-radius:14px;padding:20px 24px"><span style="flex:none;width:40px;height:40px;border-radius:50%;background:#014263;color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:18px">2</span><span style="font-size:17px" set:html={h(t['how']['span2'])}></span></li><li style="display:flex;gap:18px;align-items:flex-start;background:#fff;border:1px solid #DCE2EA;border-radius:14px;padding:20px 24px"><span style="flex:none;width:40px;height:40px;border-radius:50%;background:#014263;color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:18px">3</span><span style="font-size:17px" set:html={h(t['how']['span3'])}></span></li><li style="display:flex;gap:18px;align-items:flex-start;background:#fff;border:1px solid #DCE2EA;border-radius:14px;padding:20px 24px"><span style="flex:none;width:40px;height:40px;border-radius:50%;background:#014263;color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:18px">4</span><span style="font-size:17px" set:html={h(t['how']['span4'])}></span></li><li style="display:flex;gap:18px;align-items:flex-start;background:#fff;border:1px solid #DCE2EA;border-radius:14px;padding:20px 24px"><span style="flex:none;width:40px;height:40px;border-radius:50%;background:#014263;color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:18px">5</span><span style="font-size:17px" set:html={h(t['how']['span5'])}></span></li></ol><div style="display:flex;flex-wrap:wrap;gap:24px;justify-content:center;align-items:stretch;margin-top:10px"><figure style="margin:0;flex:1 1 280px;max-width:340px;display:flex;flex-direction:column;gap:14px"><div style="border-radius:16px;overflow:hidden;background:#F8FAFC;border:1px solid #DCE2EA;box-shadow:0 14px 30px rgba(1,66,99,0.12)"><img loading="lazy" src="/assets/img/tc-desktop-sources-card.png" alt={t['how']['alt']} style="width:100%;display:block;aspect-ratio:540/460"></div><figcaption style="font-weight:700;color:#014263;text-align:center;line-height:1.35;min-height:2.7em" set:html={h(t['how']['figcaption'])}></figcaption></figure><figure style="margin:0;flex:1 1 280px;max-width:340px;display:flex;flex-direction:column;gap:14px"><div style="border-radius:16px;overflow:hidden;background:#F8FAFC;border:1px solid #DCE2EA;box-shadow:0 14px 30px rgba(1,66,99,0.12)"><img loading="lazy" src="/assets/img/tc-desktop-draft-card.png" alt={t['how']['alt2']} style="width:100%;display:block;aspect-ratio:540/460"></div><figcaption style="font-weight:700;color:#014263;text-align:center;line-height:1.35;min-height:2.7em" set:html={h(t['how']['figcaption2'])}></figcaption></figure><figure style="margin:0;flex:1 1 280px;max-width:340px;display:flex;flex-direction:column;gap:14px"><div style="border-radius:16px;overflow:hidden;background:#F8FAFC;border:1px solid #DCE2EA;box-shadow:0 14px 30px rgba(1,66,99,0.12)"><img loading="lazy" src="/assets/img/tc-desktop-notes-card.png" alt={t['how']['alt3']} style="width:100%;display:block;aspect-ratio:540/460"></div><figcaption style="font-weight:700;color:#014263;text-align:center;line-height:1.35;min-height:2.7em" set:html={h(t['how']['figcaption3'])}></figcaption></figure></div></div></section>
<section id="btservant"><div class="wrap" style="padding-top:40px;padding-bottom:40px"><div style="border-top:1px solid #DCE2EA;border-bottom:1px solid #DCE2EA;padding:36px 0;display:flex;flex-wrap:wrap;align-items:center;gap:20px 48px"><a href="https://www.btservant.ai/" aria-label={t['btservant']['label']} style="flex:none;display:block"><img loading="lazy" src="/assets/img/bt-servant-logo.png" alt={t['btservant']['alt']} style="height:56px;width:auto;display:block"></a><div style="flex:1 1 380px"><h2 style="font-size:28px;color:#014263" set:html={h(t['btservant']['h2'])}></h2><p style="font-size:18px;margin-top:6px" set:html={h(t['btservant']['p'])}></p></div></div></div></section>
<section id="downloads" style="background:#fff"><div class="wrap" style="padding-top:64px;padding-bottom:64px;gap:30px"><div style="max-width:700px;display:flex;flex-direction:column;gap:10px"><h2 style="font-size:38px;color:#014263" set:html={h(t['downloads']['h2'])}></h2><p style="font-size:18px" set:html={h(t['downloads']['p'])}></p></div><div style="display:flex;flex-wrap:wrap;gap:20px"><div class="card" style="flex:1 1 300px;border:2px solid #014263;gap:8px"><h3 style="font-size:24px;color:#014263" set:html={h(t['downloads']['h3'])}></h3><p style="font-size:15px;color:#3A3638" set:html={h(t['downloads']['p2'])}></p><p style="font-size:14px;color:#3A3638;flex-grow:1" set:html={h(t['downloads']['p3'])}></p><div><a class="btn btn-primary" href="https://github.com/unfoldingWord/translationCore4/releases/download/v4.1.0-preview/translationCore4-4.1.0-preview-windows-x64.exe" style="font-size:15px" set:html={h(t['downloads']['a'])}></a></div></div><div class="card" style="flex:1 1 300px;border:2px solid #014263;gap:8px"><h3 style="font-size:24px;color:#014263" set:html={h(t['downloads']['h32'])}></h3><p style="font-size:15px;color:#3A3638" set:html={h(t['downloads']['p4'])}></p><p style="font-size:14px;color:#3A3638;flex-grow:1" set:html={h(t['downloads']['p5'])}></p><div><a class="btn btn-primary" href="https://github.com/unfoldingWord/translationCore4/releases/download/v4.1.0-preview/translationCore4-4.1.0-preview-macos-arm64-unsigned.pkg" style="font-size:15px" set:html={h(t['downloads']['a2'])}></a></div></div><div class="card" style="flex:1 1 300px;border:2px solid #014263;gap:8px"><h3 style="font-size:24px;color:#014263" set:html={h(t['downloads']['h33'])}></h3><p style="font-size:15px;color:#3A3638" set:html={h(t['downloads']['p6'])}></p><p style="font-size:14px;color:#3A3638;flex-grow:1" set:html={h(t['downloads']['p7'])}></p><div><a class="btn btn-primary" href="https://github.com/unfoldingWord/translationCore4/releases/download/v4.1.0-preview/translationCore4-4.1.0-preview-linux-x64.zip" style="font-size:15px" set:html={h(t['downloads']['a3'])}></a></div></div></div><div style="background:#FFF3DF;border-left:5px solid #E59D33;border-radius:0 12px 12px 0;padding:16px 22px;max-width:860px"><p style="font-size:16px" set:html={h(t['downloads']['p8'])}></p></div><p style="font-size:16px" set:html={h(t['downloads']['p9'])}></p></div></section>
<section id="previous" style="background:#F1F4F8"><div class="wrap" style="padding-top:48px;padding-bottom:48px;gap:30px"><div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px"><div style="flex:1 1 460px;display:flex;flex-direction:column;gap:10px"><h2 style="font-size:32px;color:#014263" set:html={h(t['previous']['h2'])}></h2><p style="font-size:18px" set:html={h(t['previous']['p'])}></p></div><a class="btn btn-secondary" href={p('previous-version')} set:html={h(t['previous']['a'])}></a></div></div></section>
<section id="open" style="background:#EEF1F6"><div class="wrap" style="padding-top:48px;padding-bottom:48px;gap:30px"><div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px"><div style="flex:1 1 480px"><h2 style="font-size:32px;color:#014263" set:html={h(t['open']['h2'])}></h2><p style="font-size:18px;margin-top:8px" set:html={h(t['open']['p'])}></p></div><div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn btn-primary" href="https://discord.gg/hHqjH2xtw5" set:html={h(t['open']['a'])}></a><a class="btn btn-secondary" href="https://github.com/unfoldingWord/translationCore4" set:html={h(t['open']['a2'])}></a></div></div></div></section>
</Base>
