---
// HomePage: the home page, rendered once per locale.
// Markup migrated verbatim from the hand-written index.html of the static
// site; every visible string comes from src/i18n/{locale}/home.json.
import Base from '../../layouts/Base.astro';
import { content } from '../../i18n/content';
import { localePath, localizeLinks, type PageSlug } from '../../i18n/config';
import { pageJsonLd, faqNode, SITE_URL } from '../../lib/jsonld';
import { byCode } from '../../i18n/config';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = content<any>(locale, 'home');
const h = (s: string) => localizeLinks(s, locale);
const p = (slug: PageSlug, hash = '') => localePath(locale, slug) + hash;
// The FAQ: one list drives both the visible section and the FAQPage JSON-LD,
// so the structured data always matches what the page shows.
const faq = [1, 2, 3, 4].map((n) => ({ q: h(t.faq[`q${n}`]), a: h(t.faq[`a${n}`]) }));
const jsonLd = [...pageJsonLd('home', locale), faqNode(SITE_URL + localePath(locale, 'home'), byCode(locale).tag, faq)];
---

<Base locale={locale} slug="home" title={t.meta.title} description={t.meta.description} jsonLd={jsonLd} github="https://github.com/unfoldingWord/translationCore4">
<section style="background:linear-gradient(135deg,#01263a 0%,#014263 55%,#0a6f9c 100%);color:#fff;overflow:hidden"><div style="max-width:1180px;margin:0 auto;padding:88px 32px 100px;display:flex;flex-wrap:wrap;align-items:center;gap:56px;box-sizing:border-box">
