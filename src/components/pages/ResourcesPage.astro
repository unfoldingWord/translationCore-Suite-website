---
// ResourcesPage: the /resources/ page, rendered once per locale.
// Markup migrated verbatim from the hand-written resources.html of the static
// site; every visible string comes from src/i18n/{locale}/resources.json.
import Base from '../../layouts/Base.astro';
import { content } from '../../i18n/content';
import { localePath, localizeLinks, type PageSlug } from '../../i18n/config';
import { pageJsonLd } from '../../lib/jsonld';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = content<any>(locale, 'resources');
const h = (s: string) => localizeLinks(s, locale);
const p = (slug: PageSlug, hash = '') => localePath(locale, slug) + hash;
---

<Base locale={locale} slug="resources" title={t.meta.title} description={t.meta.description} jsonLd={pageJsonLd('resources', locale)} github="https://github.com/unfoldingWord/translationCore4">
<section style="background:linear-gradient(135deg,#01263a 0%,#014263 55%,#0a6f9c 100%);color:#fff"><div class="wrap" style="padding-top:36px;padding-bottom:88px;gap:20px"><p style="font-size:14px;color:#CDEBF1" set:html={h(t['hero']['p'])}></p><h1 style="font-size:56px;color:#fff;max-width:860px;margin-top:14px" set:html={h(t['hero']['h1'])}></h1><p style="font-size:21px;color:#EEF1F6;max-width:640px" set:html={h(t['hero']['p2'])}></p><div style="display:flex;flex-wrap:wrap;gap:14px;align-items:center"><a class="btn helps-dialog-trigger" id="download-helps" href="https://git.door43.org/unfoldingWord/en_tn/releases/latest" style="background:#fff;color:#231F20" set:html={h(t['hero']['a'])}></a><a class="btn" href="https://tc-study.pages.dev/read" target="_blank" rel="noopener" style="background:transparent;color:#fff;border:2px solid rgba(255,255,255,0.6);padding:11px 24px" set:html={h(t['hero']['a2'])}></a></div></div></section>
<a id="resources"></a><a id="translation-notes"></a>
<section id="notes" style="background:#fff"><div class="wrap" style="padding-top:56px;padding-bottom:56px;gap:30px"><div style="display:flex;flex-wrap:wrap;gap:48px;align-items:center"><div style="flex:1 1 440px;display:flex;flex-direction:column;gap:16px"><h2 style="font-size:36px;color:#014263" set:html={h(t['notes']['h2'])}></h2><p style="font-size:18px" set:html={h(t['notes']['p'])}></p><ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:12px"><li style="display:flex;gap:12px"><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" style="flex:none"><circle cx="11" cy="11" r="11" fill="#E4F3F4"/><path d="M6 11.5l3.2 3.2L16 7.8" fill="none" stroke="#014263" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong set:html={h(t['notes']['strong'])}></strong></span></li><li style="display:flex;gap:12px"><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" style="flex:none"><circle cx="11" cy="11" r="11" fill="#E4F3F4"/><path d="M6 11.5l3.2 3.2L16 7.8" fill="none" stroke="#014263" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong set:html={h(t['notes']['strong2'])}></strong></span></li><li style="display:flex;gap:12px"><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" style="flex:none"><circle cx="11" cy="11" r="11" fill="#E4F3F4"/><path d="M6 11.5l3.2 3.2L16 7.8" fill="none" stroke="#014263" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong set:html={h(t['notes']['strong3'])}></strong></span></li></ul><div style="display:flex;flex-wrap:wrap;gap:12px"><a class="btn btn-primary helps-dialog-trigger" href="https://git.door43.org/unfoldingWord/en_tn/releases/latest" style="font-size:15px" set:html={h(t['notes']['a'])}></a><a class="btn btn-secondary" href="https://preview.door43.org/u/unfoldingWord/en_tn/" target="_blank" rel="noopener" style="font-size:15px" set:html={h(t['notes']['a2'])}></a></div></div><div style="flex:1 1 380px"><div style="border-radius:16px;overflow:hidden;background:#F8FAFC;border:1px solid #DCE2EA;box-shadow:0 14px 30px rgba(1,66,99,0.12)"><img loading="lazy" src="/assets/img/tc-desktop-notes-card.png" alt={t['notes']['alt']} style="width:100%;display:block;aspect-ratio:540/460"></div></div></div></div></section>
<a id="translation-words"></a>
