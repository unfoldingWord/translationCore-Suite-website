oopener" style="font-size:15px" set:html={h(t['academy']['a2'])}></a></div></div><div style="flex:1 1 380px"><div style="background:#fff;border:1px solid #DCE2EA;border-radius:16px;box-shadow:0 14px 30px rgba(1,66,99,0.12);padding:28px"><span style="display:inline-block;background:#E59D33;color:#231F20;font-weight:700;font-size:14px;letter-spacing:.06em;border-radius:8px;padding:4px 12px" set:html={h(t['academy']['span'])}></span><h3 style="font-size:26px;color:#014263;margin:14px 0 8px" set:html={h(t['academy']['h3'])}></h3><div style="display:flex;gap:12px;align-items:baseline;padding:12px 0;border-top:1px solid #E3EDF2"><strong style="color:#014263;font-size:18px;min-width:150px" set:html={h(t['academy']['strong4'])}></strong><span style="font-size:16px" set:html={h(t['academy']['span2'])}></span></div><div style="display:flex;gap:12px;align-items:baseline;padding:12px 0;border-top:1px solid #E3EDF2"><strong style="color:#014263;font-size:18px;min-width:150px" set:html={h(t['academy']['strong5'])}></strong><span style="font-size:16px" set:html={h(t['academy']['span3'])}></span></div><div style="display:flex;gap:12px;align-items:baseline;padding:12px 0;border-top:1px solid #E3EDF2"><strong style="color:#014263;font-size:18px;min-width:150px" set:html={h(t['academy']['strong6'])}></strong><span style="font-size:16px" set:html={h(t['academy']['span4'])}></span></div></div></div></div></div></section>
