<section id="sources" style="background:#F1F4F8"><div class="wrap" style="padding-top:56px;padding-bottom:56px;gap:30px"><div style="max-width:700px;display:flex;flex-direction:column;gap:10px"><h2 style="font-size:38px;color:#014263" set:html={h(t['sources']['h2'])}></h2><p style="font-size:18px" set:html={h(t['sources']['p'])}></p></div><div style="display:flex;flex-wrap:wrap;gap:20px"><div class="card" style="flex:1 1 440px;gap:12px"><h3 style="font-size:26px;color:#014263" set:html={h(t['sources']['h3'])}></h3><p style="font-size:17px" set:html={h(t['sources']['p2'])}></p><div><a class="btn btn-secondary" href="https://git.door43.org/unfoldingWord/en_ult/releases/latest" data-download="en_ult" target="_blank" rel="noopener" style="font-size:15px" set:html={h(t['sources']['a'])}></a></div></div><div class="card" style="flex:1 1 440px;gap:12px"><h3 style="font-size:26px;color:#014263" set:html={h(t['sources']['h32'])}></h3><p style="font-size:17px" set:html={h(t['sources']['p3'])}></p><div><a class="btn btn-secondary" href="https://git.door43.org/unfoldingWord/en_ust/releases/latest" data-download="en_ust" target="_blank" rel="noopener" style="font-size:15px" set:html={h(t['sources']['a2'])}></a></div></div></div></div></section>
<a id="translation-questions"></a>
<section id="questions" style="background:#fff"><div class="wrap" style="padding-top:56px;padding-bottom:56px;gap:30px"><div style="max-width:700px;display:flex;flex-direction:column;gap:10px"><h2 style="font-size:38px;color:#014263" set:html={h(t['questions']['h2'])}></h2><p style="font-size:18px" set:html={h(t['questions']['p'])}></p></div><ol style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:14px"><li style="display:flex;gap:18px;align-items:flex-start;background:#fff;border:1px solid #DCE2EA;border-radius:14px;padding:20px 24px"><span style="flex:none;width:40px;height:40px;border-radius:50%;background:#014263;color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:18px">1</span><span style="font-size:17px" set:html={h(t['questions']['span'])}></span></li><li style="display:flex;gap:18px;align-items:flex-start;background:#fff;border:1px solid #DCE2EA;border-radius:14px;padding:20px 24px"><span style="flex:none;width:40px;height:40px;border-radius:50%;background:#014263;color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:18px">2</span><span style="font-size:17px" set:html={h(t['questions']['span2'])}></span></li><li style="display:flex;gap:18px;align-items:flex-start;background:#fff;border:1px solid #DCE2EA;border-radius:14px;padding:20px 24px"><span style="flex:none;width:40px;height:40px;border-radius:50%;background:#014263;color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:18px">3</span><span style="font-size:17px" set:html={h(t['questions']['span3'])}></span></li></ol><div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn btn-primary" href="https://git.door43.org/unfoldingWord/en_tq/releases/latest" data-download="en_tq" target="_blank" rel="noopener" set:html={h(t['questions']['a'])}></a><a class="btn btn-secondary" href="https://preview.door43.org/u/unfoldingWord/en_tq/" data-door43="en_tq" target="_blank" rel="noopener" set:html={h(t['questions']['a2'])}></a></div></div></section>
<section id="btservant"><div class="wrap" style="padding-top:40px;padding-bottom:40px"><div style="border-top:1px solid #DCE2EA;border-bottom:1px solid #DCE2EA;padding:36px 0;display:flex;flex-wrap:wrap;align-items:center;gap:20px 48px"><a href="https://www.btservant.ai/" aria-label={t['btservant']['label']} style="flex:none;display:block"><img loading="lazy" src="/assets/img/bt-servant-logo.png" alt={t['btservant']['alt']} style="height:56px;width:auto;display:block"></a><div style="flex:1 1 380px"><h2 style="font-size:28px;color:#014263" set:html={h(t['btservant']['h2'])}></h2><p style="font-size:18px;margin-top:6px" set:html={h(t['btservant']['p'])}></p><a href="https://www.btservant.ai/" style="display:inline-block;margin-top:14px;font-weight:700;font-size:18px;color:#014263;text-decoration:none;border-bottom:2px solid #31ADE3;padding-bottom:2px" set:html={h(t['btservant']['a'])}></a></div></div></div></section>
<Fragment slot="after">
<div id="helps-dialog" class="helps-dialog" role="dialog" aria-modal="true" aria-labelledby="helps-dialog-title" hidden aria-hidden="true">
<div class="helps-dialog__backdrop" data-helps-close></div>
<div class="helps-dialog__panel">
<button type="button" class="helps-dialog__close" data-helps-close aria-label={t['dialog']['label']}>&times;</button>
<p class="eyebrow" set:html={h(t['dialog']['p'])}></p>
<h2 id="helps-dialog-title" set:html={h(t['dialog']['h2'])}></h2>
<p class="lead" set:html={h(t['dialog']['p2'])}></p>
<label class="select-label" for="book-select" set:html={h(t['dialog']['label2'])}></label>
<div class="select-wrapper"><select id="book-select" class="book-select"><option value="" disabled selected set:html={h(t['dialog']['option'])}></option></select></div>
<p id="download-message" class="helps-status" aria-live="polite"></p>
</div></div>
</Fragment>
<Fragment slot="scripts">
<script type="application/json" id="helps-strings" set:html={JSON.stringify(t.helps)} />
<script is:inline src="/assets/js/helps-dialog.js" defer></script>
<script is:inline src="/assets/js/helps.js" defer></script>
<script is:inline src="/assets/js/resource-links.js" defer></script>
</Fragment>
</Base>
