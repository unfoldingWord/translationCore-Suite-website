---
// MobilePage: the /mobile/ page, rendered once per locale.
// Markup migrated verbatim from the hand-written mobile.html of the static
// site; every visible string comes from src/i18n/{locale}/mobile.json.
import Base from '../../layouts/Base.astro';
import { content } from '../../i18n/content';
import { localePath, localizeLinks, type PageSlug } from '../../i18n/config';
import { pageJsonLd } from '../../lib/jsonld';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = content<any>(locale, 'mobile');
const h = (s: string) => localizeLinks(s, locale);
const p = (slug: PageSlug, hash = '') => localePath(locale, slug) + hash;
---

<Base locale={locale} slug="mobile" title={t.meta.title} description={t.meta.description} jsonLd={pageJsonLd('mobile', locale)} github="https://github.com/unfoldingWord/tc-mobile">
<section style="background:linear-gradient(135deg,#01263a 0%,#014263 55%,#0a6f9c 100%);color:#fff"><div class="wrap" style="padding-top:36px;padding-bottom:88px;gap:20px"><p style="font-size:14px;color:#CDEBF1" set:html={h(t['hero']['p'])}></p>
<div style="display:flex;flex-wrap:wrap;align-items:center;gap:48px;margin-top:14px"><div style="flex:1 1 480px;display:flex;flex-direction:column;gap:20px">
<div style="display:flex;align-items:center;gap:16px"><div style="width:76px;height:76px;background:#fff;border-radius:18px;display:flex;align-items:center;justify-content:center"><img loading="lazy" src="/assets/img/tc-mobile-logo.png" alt={t['hero']['alt']} style="width:64px;height:64px;object-fit:contain"></div><p style="font-weight:700;letter-spacing:.08em;text-transform:none;font-size:16px;color:#70C9CC" set:html={h(t['hero']['p2'])}></p></div>
<h1 style="font-size:54px;color:#fff" set:html={h(t['hero']['h1'])}></h1>
<p style="font-size:21px;color:#EEF1F6;max-width:560px" set:html={h(t['hero']['p3'])}></p>
<div style="display:flex;flex-wrap:wrap;gap:14px;align-items:center"><a class="btn" href="#install" style="background:#fff;color:#231F20" set:html={h(t['hero']['a'])}></a><span style="font-size:15px;color:#CDEBF1" set:html={h(t['hero']['span'])}></span></div></div>
<div style="flex:1 1 300px;display:flex;justify-content:center"><img loading="lazy" src="/assets/img/tc-mobile-phone-record.png" alt={t['hero']['alt2']} width="387" height="686" style="width:260px;height:auto;display:block;filter:drop-shadow(0 24px 36px rgba(0,0,0,0.45))"></div></div></div></section>
<section id="what" style="background:#fff"><div class="wrap" style="padding-top:56px;padding-bottom:56px;gap:30px"><div style="display:flex;flex-wrap:wrap;gap:40px;align-items:center"><div style="flex:1 1 420px"><h2 style="font-size:38px;color:#014263" set:html={h(t['what']['h2'])}></h2></div><p style="font-size:20px;flex:1 1 460px" set:html={h(t['what']['p'])}></p></div></div></section>
<section id="why" style="background:#F1F4F8"><div class="wrap" style="padding-top:64px;padding-bottom:64px;gap:30px"><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:20px"><div class="card"><h3 style="font-size:22px;color:#014263" set:html={h(t['why']['h3'])}></h3><p style="font-size:16px" set:html={h(t['why']['p'])}></p></div><div class="card"><h3 style="font-size:22px;color:#014263" set:html={h(t['why']['h32'])}></h3><p style="font-size:16px" set:html={h(t['why']['p2'])}></p></div><div class="card"><h3 style="font-size:22px;color:#014263" set:html={h(t['why']['h33'])}></h3><p style="font-size:16px" set:html={h(t['why']['p3'])}></p></div><div class="card"><h3 style="font-size:22px;color:#014263" set:html={h(t['why']['h34'])}></h3><p style="font-size:16px" set:html={h(t['why']['p4'])}></p></div></div></div></section>
<section id="how" style="background:#fff"><div class="wrap" style="padding-top:64px;padding-bottom:64px;gap:30px"><div style="max-width:700px;display:flex;flex-direction:column;gap:10px"><h2 style="font-size:38px;color:#014263" set:html={h(t['how']['h2'])}></h2></div><div style="display:flex;flex-wrap:wrap;gap:24px;justify-content:center"><figure style="margin:0;flex:1 1 200px;max-width:230px;display:flex;flex-direction:column;align-items:center;gap:12px"><img loading="lazy" src="/assets/img/tc-mobile-phone-books.png" alt={t['how']['alt']} width="387" height="686" style="width:100%;height:auto;display:block;filter:drop-shadow(0 16px 22px rgba(1,66,99,0.28))"><figcaption style="font-weight:700;color:#014263;text-align:center;font-size:15px" set:html={h(t['how']['figcaption'])}></figcaption></figure><figure style="margin:0;flex:1 1 200px;max-width:230px;display:flex;flex-direction:column;align-items:center;gap:12px"><img loading="lazy" src="/assets/img/tc-mobile-phone-segments.png" alt={t['how']['alt2']} width="387" height="686" style="width:100%;height:auto;display:block;filter:drop-shadow(0 16px 22px rgba(1,66,99,0.28))"><figcaption style="font-weight:700;color:#014263;text-align:center;font-size:15px" set:html={h(t['how']['figcaption2'])}></figcaption></figure><figure style="margin:0;flex:1 1 200px;max-width:230px;display:flex;flex-direction:column;align-items:center;gap:12px"><img loading="lazy" src="/assets/img/tc-mobile-phone-record.png" alt={t['how']['alt3']} width="387" height="686" style="width:100%;height:auto;display:block;filter:drop-shadow(0 16px 22px rgba(1,66,99,0.28))"><figcaption style="font-weight:700;color:#014263;text-align:center;font-size:15px" set:html={h(t['how']['figcaption3'])}></figcaption></figure><figure style="margin:0;flex:1 1 200px;max-width:230px;display:flex;flex-direction:column;align-items:center;gap:12px"><img loading="lazy" src="/assets/img/tc-mobile-phone-edit.png" alt={t['how']['alt4']} width="387" height="686" style="width:100%;height:auto;display:block;filter:drop-shadow(0 16px 22px rgba(1,66,99,0.28))"><figcaption style="font-weight:700;color:#014263;text-align:center;font-size:15px" set:html={h(t['how']['figcaption4'])}></figcaption></figure></div><ol style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:14px"><li style="display:flex;gap:18px;align-items:flex-start;background:#fff;border:1px solid #DCE2EA;border-radius:14px;padding:20px 24px"><span style="flex:none;width:40px;height:40px;border-radius:50%;background:#014263;color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:18px">1</span><span style="font-size:17px" set:html={h(t['how']['span'])}></span></li><li style="display:flex;gap:18px;align-items:flex-start;background:#fff;border:1px solid #DCE2EA;border-radius:14px;padding:20px 24px"><span style="flex:none;width:40px;height:40px;border-radius:50%;background:#014263;color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:18px">2</span><span style="font-size:17px" set:html={h(t['how']['span2'])}></span></li><li style="display:flex;gap:18px;align-items:flex-start;background:#fff;border:1px solid #DCE2EA;border-radius:14px;padding:20px 24px"><span style="flex:none;width:40px;height:40px;border-radius:50%;background:#014263;color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:18px">3</span><span style="font-size:17px" set:html={h(t['how']['span3'])}></span></li><li style="display:flex;gap:18px;align-items:flex-start;background:#fff;border:1px solid #DCE2EA;border-radius:14px;padding:20px 24px"><span style="flex:none;width:40px;height:40px;border-radius:50%;background:#014263;color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:18px">4</span><span style="font-size:17px" set:html={h(t['how']['span4'])}></span></li></ol></div></section>
<section id="btservant"><div class="wrap" style="padding-top:40px;padding-bottom:40px"><div style="border-top:1px solid #DCE2EA;border-bottom:1px solid #DCE2EA;padding:36px 0;display:flex;flex-wrap:wrap;align-items:center;gap:20px 48px"><a href="https://www.btservant.ai/" aria-label={t['btservant']['label']} style="flex:none;display:block"><img loading="lazy" src="/assets/img/bt-servant-logo.png" alt={t['btservant']['alt']} style="height:56px;width:auto;display:block"></a><div style="flex:1 1 380px"><h2 style="font-size:28px;color:#014263" set:html={h(t['btservant']['h2'])}></h2><p style="font-size:18px;margin-top:6px" set:html={h(t['btservant']['p'])}></p><a href="https://www.btservant.ai/" style="display:inline-block;margin-top:14px;font-weight:700;font-size:18px;color:#014263;text-decoration:none;border-bottom:2px solid #31ADE3;padding-bottom:2px" set:html={h(t['btservant']['a'])}></a></div></div></div></section>
<section id="install" style="background:#EEF1F6"><div class="wrap" style="padding-top:64px;padding-bottom:64px;gap:30px"><div style="max-width:700px;display:flex;flex-direction:column;gap:10px"><h2 style="font-size:38px;color:#014263" set:html={h(t['install']['h2'])}></h2></div><div style="display:flex;flex-wrap:wrap;gap:20px;align-items:stretch"><div id="android" class="card" style="flex:1 1 280px;border:2px solid #014263;gap:12px"><h3 style="font-size:24px;color:#014263" set:html={h(t['install']['h3'])}></h3><p style="font-size:17px" set:html={h(t['install']['p'])}></p><p style="font-size:14px;color:#3A3638;flex-grow:1" set:html={h(t['install']['p2'])}></p><div><a class="btn btn-primary" href="https://play.google.com/store/apps/details?id=org.unfoldingword.tcmobile" set:html={h(t['install']['a'])}></a></div></div><div id="iphone" class="card" style="flex:1 1 280px;border:2px solid #014263;gap:12px"><h3 style="font-size:24px;color:#014263" set:html={h(t['install']['h32'])}></h3><p style="font-size:17px" set:html={h(t['install']['p3'])}></p><p style="font-size:14px;color:#3A3638;flex-grow:1" set:html={h(t['install']['p4'])}></p><div><a class="btn btn-primary" href="https://apps.apple.com/us/app/translationcore-mobile/id6811348123" set:html={h(t['install']['a2'])}></a></div></div><div class="card" style="flex:1 1 280px;border:2px solid #014263;gap:12px"><h3 style="font-size:24px;color:#014263" set:html={h(t['install']['h33'])}></h3><p style="font-size:17px" set:html={h(t['install']['p5'])}></p><p style="font-size:14px;color:#3A3638;flex-grow:1" set:html={h(t['install']['p6'])}></p><div><a class="btn btn-primary" href="https://tcmobile.app" set:html={h(t['install']['a3'])}></a></div></div></div><p style="font-size:16px" set:html={h(t['install']['p7'])}></p></div></section>
</Base>
