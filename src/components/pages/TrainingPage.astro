---
// TrainingPage: the /training/ page, rendered once per locale.
// Markup migrated verbatim from the hand-written training.html of the static
// site; every visible string comes from src/i18n/{locale}/training.json.
import Base from '../../layouts/Base.astro';
import { content } from '../../i18n/content';
import { localePath, localizeLinks, type PageSlug } from '../../i18n/config';
import { pageJsonLd } from '../../lib/jsonld';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = content<any>(locale, 'training');
const h = (s: string) => localizeLinks(s, locale);
const p = (slug: PageSlug, hash = '') => localePath(locale, slug) + hash;
---

<Base locale={locale} slug="training" title={t.meta.title} description={t.meta.description} jsonLd={pageJsonLd('training', locale)} github="https://github.com/unfoldingWord/translationCore4">
<section style="background:linear-gradient(135deg,#01263a 0%,#014263 55%,#0a6f9c 100%);color:#fff"><div class="wrap" style="padding-top:36px;padding-bottom:88px;gap:20px"><p style="font-size:14px;color:#CDEBF1" set:html={h(t['hero']['p'])}></p><h1 style="font-size:56px;color:#fff;max-width:860px;margin-top:14px" set:html={h(t['hero']['h1'])}></h1><p style="font-size:21px;color:#EEF1F6;max-width:640px" set:html={h(t['hero']['p2'])}></p><div style="display:flex;flex-wrap:wrap;gap:14px;align-items:center"><a class="btn" href="#initiatives" style="background:#fff;color:#231F20" set:html={h(t['hero']['a'])}></a></div></div></section>
<section id="initiatives" style="background:#fff"><div class="wrap" style="padding-top:64px;padding-bottom:64px;gap:30px"><div style="max-width:700px;display:flex;flex-direction:column;gap:10px"><h2 style="font-size:38px;color:#014263" set:html={h(t['initiatives']['h2'])}></h2><p style="font-size:18px" set:html={h(t['initiatives']['p'])}></p></div><div style="display:flex;flex-wrap:wrap;gap:20px"><div class="card" style="flex:1 1 440px;gap:14px"><div style="display:flex;align-items:center;gap:14px"><span style="flex:none;width:44px;height:44px;border-radius:12px;background:#fff;border:1px solid #DCE2EA;display:flex;align-items:center;justify-content:center"><img loading="lazy" src="/assets/img/foundations-bt-logo.png" alt="" style="width:30px;height:30px;object-fit:contain"></span><h3 style="font-size:24px;color:#014263" set:html={h(t['initiatives']['h3'])}></h3></div><p style="font-size:17px;flex-grow:1" set:html={h(t['initiatives']['p2'])}></p><div><a class="btn btn-secondary" href="https://foundationsbt.com/" style="font-size:15px" set:html={h(t['initiatives']['a'])}></a></div></div><div class="card" style="flex:1 1 440px;gap:14px"><div style="display:flex;align-items:center;gap:14px"><span style="flex:none;width:44px;height:44px;border-radius:12px;background:#DDEFF0;display:flex;align-items:center;justify-content:center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#014263" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v4M10 5h4M5 21V12l7-5 7 5v9zM10 21v-5h4v5"/></svg></span><h3 style="font-size:24px;color:#014263" set:html={h(t['initiatives']['h32'])}></h3></div><p style="font-size:17px;flex-grow:1" set:html={h(t['initiatives']['p3'])}></p><div><a class="btn btn-secondary" href="https://churchbased.bible/" style="font-size:15px" set:html={h(t['initiatives']['a2'])}></a></div></div><div class="card" style="flex:1 1 440px;gap:14px"><div style="display:flex;align-items:center;gap:14px"><span style="flex:none;width:44px;height:44px;border-radius:12px;background:#fff;border:1px solid #DCE2EA;display:flex;align-items:center;justify-content:center"><img loading="lazy" src="/assets/img/bt-servant-mark.png" alt="" style="width:30px;height:30px;object-fit:contain"></span><h3 style="font-size:24px;color:#014263" set:html={h(t['initiatives']['h33'])}></h3></div><p style="font-size:17px;flex-grow:1" set:html={h(t['initiatives']['p4'])}></p><div><a class="btn btn-secondary" href="https://www.btservant.ai/" style="font-size:15px" set:html={h(t['initiatives']['a3'])}></a></div></div><div class="card" style="flex:1 1 440px;gap:14px"><div style="display:flex;align-items:center;gap:14px"><span style="flex:none;width:44px;height:44px;border-radius:12px;background:#DDEFF0;display:flex;align-items:center;justify-content:center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#014263" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 15l5-4 4 3 3-2 6 4"/></svg></span><h3 style="font-size:24px;color:#014263" set:html={h(t['initiatives']['h34'])}></h3></div><p style="font-size:17px;flex-grow:1" set:html={h(t['initiatives']['p5'])}></p><div><a class="btn btn-secondary" href="https://openbiblestories.org/" style="font-size:15px" set:html={h(t['initiatives']['a4'])}></a></div></div></div></div></section>
<section id="help" style="background:#F1F4F8"><div class="wrap" style="padding-top:64px;padding-bottom:64px;gap:30px"><div style="max-width:700px;display:flex;flex-direction:column;gap:10px"><h2 style="font-size:38px;color:#014263" set:html={h(t['help']['h2'])}></h2></div><div style="display:flex;flex-wrap:wrap;gap:20px"><div class="card" style="flex:1 1 300px;gap:14px"><div style="display:flex;align-items:center;gap:14px"><span style="flex:none;width:44px;height:44px;border-radius:12px;background:#DDEFF0;display:flex;align-items:center;justify-content:center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#014263" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h14v10H8l-4 4zM17 9h4v9l-3-2h-6v-1"/></svg></span><h3 style="font-size:24px;color:#014263" set:html={h(t['help']['h3'])}></h3></div><p style="font-size:17px;flex-grow:1" set:html={h(t['help']['p'])}></p><div><a class="btn btn-secondary" href="https://discord.gg/hHqjH2xtw5" style="font-size:15px" set:html={h(t['help']['a'])}></a></div></div><div class="card" style="flex:1 1 300px;gap:14px"><div style="display:flex;align-items:center;gap:14px"><span style="flex:none;width:44px;height:44px;border-radius:12px;background:#DDEFF0;display:flex;align-items:center;justify-content:center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#014263" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h14v10H8l-4 4zM17 9h4v9l-3-2h-6v-1"/></svg></span><h3 style="font-size:24px;color:#014263" set:html={h(t['help']['h32'])}></h3></div><p style="font-size:17px;flex-grow:1" set:html={h(t['help']['p2'])}></p><div><a class="btn btn-secondary" href="https://unfoldingword.org/contact" style="font-size:15px" set:html={h(t['help']['a2'])}></a></div></div></div></div></section>
<section id="academy" style="background:#fff"><div class="wrap" style="padding-top:48px;padding-bottom:48px;gap:30px"><div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px"><div style="flex:1 1 480px"><h2 style="font-size:32px;color:#014263" set:html={h(t['academy']['h2'])}></h2><p style="font-size:18px;margin-top:8px" set:html={h(t['academy']['p'])}></p></div><a class="btn btn-primary" href={p('resources', '#academy')} set:html={h(t['academy']['a'])}></a></div></div></section>
</Base>
