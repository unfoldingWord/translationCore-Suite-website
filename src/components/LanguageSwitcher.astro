---
// The language menu (same markup and behaviour as openbiblestories.org's
// switcher, styled to match the translationCore nav pills in styles.css).
import { locales, byCode, localePath, type PageSlug } from '../i18n/config';

interface Props {
  locale: string;
  slug: PageSlug;
  label?: string;
}
const { locale, slug, label = 'Language' } = Astro.props;
const current = byCode(locale);
---

<div class="lang-switcher">
  {/* The accessible name must contain the visible text ("English"), so voice
      control users saying "click English" can activate it (WCAG 2.5.3). */}
  <button type="button" class="lang-switcher-btn" aria-haspopup="true" aria-expanded="false">
    <span class="sr-only">{label}:</span>
    <span>{current.name}</span>
    <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
  </button>
  <ul class="lang-switcher-menu">
    {locales.map((l) => (
      <li>
        <a href={localePath(l.code, slug)} data-locale={l.code} lang={l.tag} dir={l.dir} aria-current={l.code === locale ? 'true' : undefined}>{l.name}</a>
      </li>
    ))}
  </ul>
</div>
