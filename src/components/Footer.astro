---
// The translationCore footer, markup carried over from the static site.
import { localePath, type PageSlug } from '../i18n/config';

interface Props {
  locale: string;
  ui: any;
  /** Repository the page is about (Desktop → translationCore, Mobile → tc-mobile). */
  github: string;
}
const { locale, ui, github } = Astro.props;
const heart = 'M12 21s-7.5-4.6-9.5-9.2C1 8 3.3 4.5 6.8 4.5c2 0 3.7 1.1 5.2 3 1.5-1.9 3.2-3 5.2-3 3.5 0 5.8 3.5 4.3 7.3C19.5 16.4 12 21 12 21z';
---

<footer style="background:#014263;color:#fff">
<div style="max-width:1180px;margin:0 auto;padding:48px 32px;display:flex;flex-wrap:wrap;gap:40px;justify-content:space-between;box-sizing:border-box">
<div style="display:flex;flex-direction:column;gap:12px;max-width:340px">
<div style="display:flex;align-items:center;gap:12px"><div style="background:#fff;border-radius:12px;padding:8px;display:flex"><img loading="lazy" src="/assets/img/tc_logo.png" alt="translationCore" style="width:44px;height:48px;object-fit:contain"></div><span style="font-weight:700;font-size:20px">translationCore&reg;</span></div>
<p style="font-size:15px;color:#CDEBF1" set:html={ui.footerTagline} /><p style="font-size:15px;color:#CDEBF1" set:html={ui.footerInitiative} /></div>
<div style="display:flex;flex-wrap:wrap;gap:48px">
<div style="display:flex;flex-direction:column;gap:10px">{ui.nav.map((item: { label: string; slug: PageSlug }) => <a class="footlink" href={localePath(locale, item.slug)} set:html={item.label} />)}</div>
<div style="display:flex;flex-direction:column;gap:10px"><a class="footlink" href={github} set:html={ui.footerLinks.github} /><a class="footlink" href={localePath(locale, 'license')} set:html={ui.footerLinks.license} /><a class="footlink" href={localePath(locale, 'privacy')} set:html={ui.footerLinks.privacy} /><a class="footlink" href="https://unfoldingword.org/" set:html={ui.footerLinks.about} /><a class="give" href="https://unfoldingword.org/give-initiative/"><svg width="20" height="20" viewBox="0 0 24 24" fill="#231F20" aria-hidden="true"><path d={heart}/></svg><span set:html={ui.give} /></a></div>
</div></div></footer>
