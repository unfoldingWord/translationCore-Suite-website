---
// The translationCore header and "An initiative of unfoldingWord" bar,
// markup carried over from the static site. The language switcher is the one
// addition: the last item in the nav, so on narrow screens it sits behind the
// same Menu button as the links.
import { localePath, isLocalized, type PageSlug } from '../i18n/config';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: string;
  ui: any;
  slug: PageSlug;
  switcher?: boolean;
}
const { locale, ui, slug, switcher } = Astro.props;
const showSwitcher = switcher ?? isLocalized(slug);
---

<header style="border-bottom:1px solid #DCE2EA">
<div style="max-width:1180px;margin:0 auto;padding:18px 32px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;box-sizing:border-box">
<a href={localePath(locale, 'home')} style="display:flex;align-items:center;gap:12px;text-decoration:none"><img src="/assets/img/tc_logo.png" alt="translationCore" style="width:40px;height:44px;object-fit:contain"><span style="font-weight:700;font-size:18px;color:#231F20">translationCore&reg;</span></a>
<nav aria-label="Main" style="display:flex;flex-wrap:wrap;align-items:center;gap:26px">
{ui.nav.map((item: { label: string; slug: PageSlug }) => (
  <a class="navlink" href={localePath(locale, item.slug)} aria-current={item.slug === slug ? 'page' : undefined} set:html={item.label} />
))}{showSwitcher && <LanguageSwitcher locale={locale} slug={slug} label={ui.strings.languageLabel} />}
</nav></div></header>
<div style="background:#EEF1F6;border-bottom:1px solid #DCE2EA"><div style="max-width:1180px;margin:0 auto;padding:7px 32px;display:flex;align-items:center;gap:10px;font-size:14px;color:#231F20;box-sizing:border-box"><span set:html={ui.initiativeOf} /><a href="https://unfoldingword.org/" aria-label="unfoldingWord" style="display:flex;align-items:center"><img src="/assets/img/unfoldingword-logo.png" alt="unfoldingWord" style="height:18px;width:auto;display:block"></a></div></div>
