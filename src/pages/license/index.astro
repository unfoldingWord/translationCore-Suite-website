---
// English-only legal page (no /{lang}/ variants, no switcher), migrated
// verbatim from the hand-written license.html of the static site.
import Base from '../../layouts/Base.astro';
import { localePath, type PageSlug } from '../../i18n/config';
const p = (slug: PageSlug, hash = '') => localePath('en', slug) + hash;
---

<Base locale="en" slug="license" title="License and Trademark | translationCore" description="License and trademark information for translationCore: MIT License for software and CC BY-SA 4.0 for content." github="https://github.com/unfoldingWord/translationCore4">
<section style="background:linear-gradient(135deg,#01263a 0%,#014263 55%,#0a6f9c 100%);color:#fff"><div class="wrap" style="padding-top:36px;padding-bottom:88px;gap:20px"><p style="font-size:14px;color:#CDEBF1"><a href={p('home')} style="color:#CDEBF1">Home</a> &nbsp;/&nbsp; License and Trademark</p><h1 style="font-size:56px;color:#fff;max-width:860px;margin-top:14px">License and Trademark</h1><p style="font-size:21px;color:#EEF1F6;max-width:640px">Open source, open content, and a trademark to protect the name.</p><div style="display:flex;flex-wrap:wrap;gap:14px;align-items:center"><a class="btn" href={p('home')} style="background:#fff;color:#231F20">Back to Home</a></div></div></section>
<section id="license" style="background:#fff"><div class="wrap" style="padding-top:72px;padding-bottom:72px;gap:30px"><div style="max-width:820px;display:flex;flex-direction:column;gap:20px"><div class="card" style="gap:12px"><h3 style="font-size:26px;color:#014263">Software</h3><p style="font-size:18px">The translationCore source code is open source, released under the <a href="https://opensource.org/license/MIT">MIT License</a>. You are free to use, copy, modify, and distribute the code, as long as the copyright and license notice stay with it.</p></div><div class="card" style="gap:12px"><h3 style="font-size:26px;color:#014263">Content</h3><p style="font-size:18px">Documentation, guides, and other non-code materials are licensed under the <a href="https://creativecommons.org/licenses/by-sa/4.0/">Creative Commons Attribution-ShareAlike 4.0 International License</a> (CC BY-SA 4.0). You are free to share and adapt them, as long as you give credit to unfoldingWord, indicate any changes, and share your adaptations under the same license.</p></div><div class="card" style="gap:12px"><h3 style="font-size:26px;color:#014263">Trademark</h3><p style="font-size:18px">translationCore is a trademark of unfoldingWord&reg;. These licenses do not grant the right to use the translationCore name or logo, other than to refer to the project truthfully. For other uses, please <a href="https://unfoldingword.org/contact-us/">contact us</a>.</p></div></div></div></section>
</Base>
