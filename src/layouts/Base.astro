---
// Shared page shell for every route, locale-aware (the same contract as
// openbiblestories.org's Base.astro, minus the content-language hubs).
//
// Props:
//   locale      — locale code ('en', 'es', …); English-only pages pass 'en'
//   slug        — page slug: drives canonical, hreflang and the language
//                 switcher. English-only slugs (license, privacy, 404) get no
//                 hreflang alternates and no switcher.
//   title, description — per-page <head> values
//   jsonLd      — extra JSON-LD nodes merged into the page's single @graph
//                 (Organization + WebSite are always present)
//   github      — the footer's GitHub link (the repository the page is about)
//
// Named slots: "after" — markup after the footer (the Resources download
// dialog); "scripts" — per-page script tags.
//
// The markup inside <body> is the hand-written translationCore design,
// carried over verbatim (inline styles included); the shared <style> block
// every page used to repeat is now /assets/css/styles.css.
import { locales, byCode, defaultLocale, localePath, fontHrefFor, isLocalized, localizedSlugs, slugPaths, type PageSlug } from '../i18n/config';
import { content } from '../i18n/content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { organizationNode, websiteNode, serializeGraph } from '../lib/jsonld';

interface Props {
  locale: string;
  slug: PageSlug;
  title: string;
  description?: string;
  jsonLd?: unknown[];
  github?: string;
}

const { locale, slug, title, description, jsonLd = [], github = 'https://github.com/unfoldingWord/translationCore4' } = Astro.props;
const def = byCode(locale);
const ui = content<any>(locale, 'ui');
const localized = isLocalized(slug);
// The 404 is served at whatever URL was missing: no canonical, not indexed.
const isNotFound = slug === '404';

const canonical = new URL(localePath(locale, slug), Astro.site);
const ogImage = new URL('/assets/img/og-image.png', Astro.site);
const fontHref = fontHrefFor(locale);
const graph = serializeGraph([organizationNode(), websiteNode(def.tag), ...jsonLd]);
// Open Graph locale tags use underscores (es_MX), not BCP-47 hyphens.
const ogLocale = (l: string) => byCode(l).tag.replace('-', '_');

// What public/assets/js/locale.js needs to resolve the visitor's preferred
// interface language (see README → Localization).
const localeMeta = JSON.stringify({
  locale,
  defaultLocale,
  alternates: localized,
  locales: locales.map((l) => l.code),
  tags: Object.fromEntries(locales.map((l) => [l.code, l.tag])),
  slugs: Object.fromEntries(localizedSlugs.map((sl) => [sl, slugPaths[sl]])),
});
---

<!doctype html>
<html lang={def.tag} dir={def.dir} data-script={def.script}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
{description && <meta name="description" content={description}>}
{isNotFound ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
<meta name="theme-color" content="#014263">
<meta property="og:type" content="website">
<meta property="og:site_name" content={ui.siteTitle}>
<meta property="og:title" content={title}>
{description && <meta property="og:description" content={description}>}
{!isNotFound && <meta property="og:url" content={canonical}>}
{localized && <meta property="og:locale" content={ogLocale(locale)}>}
{localized && locales.filter((l) => l.code !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocale(l.code)}>)}
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ui.strings.ogImageAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
{description && <meta name="twitter:description" content={description}>}
<meta name="twitter:image" content={ogImage}>
{localized && locales.map((l) => <link rel="alternate" hreflang={l.tag} href={new URL(localePath(l.code, slug), Astro.site)}>)}
{localized && <link rel="alternate" hreflang="x-default" href={new URL(localePath(defaultLocale, slug), Astro.site)}>}
<script type="application/ld+json" set:html={graph} />
<link rel="icon" type="image/png" href="/assets/img/tc_logo.png">
<!-- Avenir Next is self-hosted (see /assets/fonts/ and the @font-face rules
     in styles.css); scripts it does not cover get a self-hosted Noto pack,
     generated by scripts/build-font-css.mjs. -->
<link rel="preload" href="/assets/fonts/AvenirNext-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/AvenirNext-Bold.woff2" as="font" type="font/woff2" crossorigin>
{fontHref && <link href={fontHref} rel="stylesheet">}
<link rel="stylesheet" href="/assets/css/styles.css">
<!-- The interface-language preference (public/assets/js/locale.js). In <head>
     and not deferred: a visitor whose language has its own copy of this page
     is redirected there before the browser paints the page they are leaving. -->
<script is:inline set:html={`window.__tcLocale=${localeMeta}`} />
<script is:inline src="/assets/js/locale.js"></script>
<GoogleAnalytics />
<slot name="head" />
</head>
<body>
<a class="skip-link" href="#main">{ui.strings.skipToContent}</a>
<div style="display:flex;flex-direction:column;width:100%;background:#fff">
<Header locale={locale} ui={ui} slug={slug} switcher={localized} />
<main id="main">
<slot />
</main>
<Footer locale={locale} ui={ui} github={github} />
</div>
<slot name="after" />
<slot name="scripts" />
<script is:inline src="/assets/js/site.js" data-menu={ui.strings.menu}></script>
</body>
</html>
